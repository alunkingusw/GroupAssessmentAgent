# Copy this file to .env and fill in real values. Never commit .env.

# Microsoft Graph app registration (see README "Mailbox setup" for the Azure steps)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Notified on: unauthorised/unrecognised senders, LLM parse failures, backend submission
# failures, and infrastructure outages (Ollama/backend/mailbox unreachable).
ADMIN_EMAIL=admin@university.ac.uk

# Comma-separated. Senders in these domains who authenticate (SPF/DKIM/DMARC) but aren't a
# registered group owner get a friendly "not registered" reply instead of a silent drop.
# Senders outside these domains, or who fail authentication, are always silently dropped.
AUTHORISED_EMAIL_DOMAINS=university.ac.uk
